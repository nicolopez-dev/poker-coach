# Copy to .env and fill in from the Supabase dashboard: Project Settings → API.
# The anon key is public — it ships in the bundle, and RLS is what protects the data.
# EXPO_PUBLIC_* is inlined at build time, so restart Metro with --clear after a change.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google sign-in, from Google Cloud → APIs & Services → Credentials.
#
# The WEB client id, not the Android or iOS one: Supabase checks the ID token's audience
# against the client configured on its Google provider, and that is the web client. The
# platform clients exist so Google will mint the token — Android needs no id here at all,
# it is matched by package name and signing certificate.
#
# Client ids are public (they ship in the app). The web client *secret* is not, and does
# not belong in this file or in .env — only in the Supabase dashboard.

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
